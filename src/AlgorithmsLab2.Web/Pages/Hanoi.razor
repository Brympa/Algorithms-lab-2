@page "/hanoi"
@implements IDisposable
@inject CatalogState Catalog
@inject HanoiPlaybackService Playback
@inject TeamVizService Viz

<PageTitle>Ханойская башня</PageTitle>

<header class="page-header">
    <div>
        <h1>Ханойская башня</h1>
        <p>
            Задание 2. N = 8, минимум ходов 2⁸ − 1 = <strong>255</strong>.
            Рекурсия и стек дают идентичную последовательность. Playback — в JS, state — в C#.
        </p>
    </div>
    <span class="badge accent">@(_disks) дисков · @Playback.MoveCount ходов</span>
</header>

<section class="glass panel">
    <div class="row">
        <div class="field">
            <label>Решатель</label>
            <select @bind="_solverId" @bind:after="OnSolverChanged">
                @foreach (var s in Catalog.Hanoi.GetAll())
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
        </div>
        <div class="field">
            <label>Дисков N (1–12)</label>
            <input type="number" min="1" max="12" value="@_disks" @oninput="OnDisksInput" />
        </div>
        <div class="field" style="min-width:180px;">
            <label>Скорость · x@(Playback.Speed.ToString("0.##"))</label>
            <input type="range" min="0.25" max="4" step="0.25" value="@Playback.Speed"
                   @oninput="OnSpeedInput" />
        </div>
        <div class="field">
            <label>Шаг</label>
            <div class="stat-chip">@Playback.CurrentIndex / @Playback.MoveCount</div>
        </div>
    </div>

    <div class="btn-row" style="margin-top:12px;">
        <button class="btn primary" @onclick="Build">Собрать ходы</button>
        <button class="btn" disabled="@(_moves.Count == 0 || Playback.IsPlaying)" @onclick="Play">▶ Play</button>
        <button class="btn" disabled="@(!Playback.IsPlaying)" @onclick="Pause">⏸ Pause</button>
        <button class="btn" disabled="@(_moves.Count == 0)" @onclick="StepBack">← Шаг</button>
        <button class="btn" disabled="@(_moves.Count == 0)" @onclick="StepForward">Шаг →</button>
        <button class="btn" disabled="@(_moves.Count == 0)" @onclick="JumpStart">⏮</button>
        <button class="btn" disabled="@(_moves.Count == 0)" @onclick="JumpEnd">⏭</button>
        <button class="btn" @onclick="Reset">Сброс</button>
    </div>

    @if (_status is not null)
    {
        <p class="muted" style="margin-top:10px;">@_status</p>
    }
</section>

<section class="glass panel" style="padding:12px;">
    <div class="canvas-frame" style="min-height:360px;">
        <HanoiBoard @ref="_board" Style="width:100%;height:420px;" Hosted="OnBoardHosted" />
    </div>
</section>

<section class="glass panel">
    <h2>Сложность и режимы</h2>
    <div class="stat-row">
        <span class="stat-chip">min ходов = 2^n − 1 = @HanoiMath.MinMoves(_disks)</span>
        <span class="stat-chip">recursive</span>
        <span class="stat-chip">stack</span>
        <span class="stat-chip">эквивалентность — unit-тесты</span>
    </div>
    <p class="muted" style="margin-top:10px;">
        Рекурсия: <code>Hanoi(n,from,to,aux)</code> = <code>H(n-1,from,aux,to); move; H(n-1,aux,to,from)</code>.<br />
        Стек: явные фреймы <code>(n,from,to,aux,phase)</code> без нативной рекурсии.
    </p>
</section>

@code {
    private HanoiBoard? _board;
    private string _solverId = "hanoi-recursive";
    private int _disks = 8;
    private IReadOnlyList<HanoiMove> _moves = Array.Empty<HanoiMove>();
    private string? _status;
    private bool _boardReady;

    protected override void OnInitialized()
    {
        Playback.Changed += OnPlaybackChanged;
    }

    private async void OnPlaybackChanged()
    {
        try
        {
            await InvokeAsync(async () =>
            {
                if (_board is not null && _boardReady)
                    await _board.SetIndexAsync(Playback.CurrentIndex);
                StateHasChanged();
            });
        }
        catch
        {
            // navigation disposed
        }
    }

    private async Task OnBoardHosted()
    {
        _boardReady = true;
        await Viz.BindRangeFillsAsync();
        if (_moves.Count > 0 && _board is not null)
            await _board.LoadAsync(_disks, _moves);
    }

    private void OnDisksInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
            _disks = Math.Clamp(n, 1, 12);
    }

    private void OnSpeedInput(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var s))
            Playback.SetSpeed(s);
    }

    private void OnSolverChanged()
    {
        // rebuild with new solver if moves already built
        if (_moves.Count > 0)
            Build();
    }

    private void Build()
    {
        var solver = Catalog.Hanoi.Get(_solverId) ?? Catalog.Hanoi.GetAll().FirstOrDefault();
        if (solver is null)
        {
            _status = "Solver не найден";
            return;
        }

        var sw = System.Diagnostics.Stopwatch.StartNew();
        _moves = solver.Solve(_disks);
        sw.Stop();

        Playback.Load(_moves, _disks);
        int expected = HanoiMath.MinMoves(_disks);
        _status = _moves.Count == expected
            ? $"{solver.Name}: {_moves.Count} ходов (min {expected}) за {sw.Elapsed.TotalMilliseconds:F1} мс"
            : $"Внимание: {_moves.Count} ходов, ожидалось {expected}";

        _ = PushMovesAsync();
    }

    private async Task PushMovesAsync()
    {
        if (_board is null || !_boardReady || _moves.Count == 0)
            return;
        await _board.LoadAsync(_disks, _moves);
    }

    private void Play()
    {
        Playback.Play();
        _status = "Воспроизведение…";
    }

    private void Pause()
    {
        Playback.Pause();
        _status = "Пауза";
    }

    private async Task StepForward()
    {
        Playback.StepForward();
        if (_board is not null && _boardReady)
            await _board.SetIndexAsync(Playback.CurrentIndex);
    }

    private async Task StepBack()
    {
        Playback.StepBack();
        if (_board is not null && _boardReady)
            await _board.SetIndexAsync(Playback.CurrentIndex);
    }

    private async Task JumpStart()
    {
        Playback.Seek(0);
        if (_board is not null && _boardReady)
            await _board.SetIndexAsync(0);
    }

    private async Task JumpEnd()
    {
        Playback.Seek(Playback.MoveCount);
        if (_board is not null && _boardReady)
            await _board.SetIndexAsync(Playback.MoveCount);
        _status = "Финиш";
    }

    private void Reset()
    {
        Playback.Reset();
        _status = null;
    }

    public void Dispose()
    {
        Playback.Changed -= OnPlaybackChanged;
    }
}
