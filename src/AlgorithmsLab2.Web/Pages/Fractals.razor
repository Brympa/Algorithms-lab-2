@page "/fractals"
@implements IAsyncDisposable
@inject CatalogState Catalog
@inject CanvasRenderService CanvasService
@inject TeamVizService Viz

<PageTitle>Фракталы — Кривая Госпера</PageTitle>

<header class="page-header">
    <div>
        <h1>Фракталы</h1>
        <p>
            Задание 1. Кривая Госпера строится <strong>рекурсивно</strong>:
            порядок n — 7 кривых n−1. Сегментов: 7<sup>n</sup>. Интерактивная карта (Pan &amp; Zoom) и пошаговая постройка.
        </p>
    </div>
</header>

@if (_generator is null)
{
    <div class="glass panel">Генератор не зарегистрирован.</div>
    return;
}

<section class="glass panel">
    <h2>@_generator.Name</h2>
    <p class="muted">@_generator.Description</p>

    <div class="row" style="margin-top:12px;align-items:flex-end;">
        <div class="field" style="min-width:240px;">
            <div class="row" style="justify-content:space-between;align-items:center;margin-bottom:4px;">
                <label style="margin:0;">Порядок n (max @_maxOrder)</label>
                <input type="number" min="0" max="@_maxOrder" value="@_order"
                       @onchange="OnOrderNumberChange"
                       style="width:68px;padding:2px 8px;font-size:13px;text-align:center;border-radius:6px;border:1px solid var(--border);background:rgba(12,18,30,0.6);color:#fff;" />
            </div>
            <input type="range" min="0" max="@_maxOrder" step="1" value="@_order"
                   @oninput="OnOrderInput" />
        </div>
        <div class="field">
            <label>Толщина</label>
            <input type="range" min="0.5" max="4" step="0.1" value="@_lineWidth"
                   @oninput="OnWidthInput" />
        </div>
        <div class="field">
            <label>Сегментов</label>
            <div class="stat-chip">@_formattedSegments</div>
        </div>
        <div class="field">
            <label>Генерация</label>
            <div class="stat-chip">@_genMs.ToString("0.0") мс</div>
        </div>
        <div class="field">
            <label>Рендер</label>
            <div class="stat-chip">@_drawMs.ToString("0.0") мс</div>
        </div>
    </div>

    @if (_order >= 7)
    {
        <div class="stat-row" style="margin-top:10px;">
            <span class="badge accent">Предельная детализация (n=@_order, 7^@_order = @_formattedSegments)</span>
            <span class="muted" style="font-size:12px;align-self:center;">Субпиксельный рендеринг геометрии (823 543 точки) без OOM</span>
        </div>
    }

    <div class="btn-row" style="margin-top:12px;">
        <button class="btn primary" disabled="@_busy" @onclick="GenerateAsync">Построить</button>
        <button class="btn" disabled="@(_geometry is null)" @onclick="ExportAsync">PNG</button>
        <button class="btn" disabled="@(_canvasHost is null)" @onclick="ResetViewAsync">Сброс вида</button>
        <button class="btn" @onclick="ResetAsync">Сброс</button>
    </div>

    @if (_status is not null)
    {
        <p class="muted" style="margin-top:12px;">@_status</p>
    }
</section>

<section class="glass panel" style="margin-top:16px;">
    <div class="row" style="justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;">
        <div class="row" style="align-items:center;gap:10px;">
            <h3 style="margin:0;font-size:15px;font-weight:600;">Пошаговая постройка кривой</h3>
            <span class="badge accent">Шаг @_currentStep / @_totalSteps (@((_currentProgress * 100).ToString("0.0"))%)</span>
        </div>
        <div class="row" style="align-items:center;gap:10px;">
            <div class="stat-chip" style="font-size:12px;">Отрисовано: @_drawnSegmentsLabel / @_formattedSegments</div>
        </div>
    </div>

    <div class="row" style="margin-top:14px;align-items:center;gap:12px;flex-wrap:wrap;">
        <div class="btn-group" style="display:inline-flex;gap:4px;">
            <button class="btn" title="В начало" disabled="@(_geometry is null || _currentStep <= 0)" @onclick="SeekStartAsync">⏮</button>
            <button class="btn" title="Шаг назад" disabled="@(_geometry is null || _currentStep <= 0)" @onclick="StepBackAsync">◀</button>
            @if (_isPlaying)
            {
                <button class="btn accent" @onclick="Pause">⏸ Пауза</button>
            }
            else
            {
                <button class="btn primary" disabled="@(_geometry is null)" @onclick="PlayAsync">▶ Воспроизведение</button>
            }
            <button class="btn" title="Шаг вперед" disabled="@(_geometry is null || _currentStep >= _totalSteps)" @onclick="StepForwardAsync">▶</button>
            <button class="btn" title="В конец" disabled="@(_geometry is null || _currentStep >= _totalSteps)" @onclick="SeekEndAsync">⏭</button>
        </div>

        <div style="flex:1;min-width:200px;display:flex;align-items:center;gap:10px;">
            <input type="range" min="0" max="@_totalSteps" step="1" value="@_currentStep"
                   disabled="@(_geometry is null)"
                   @oninput="OnProgressSliderInput" style="flex:1;" />
        </div>

        <div class="row" style="align-items:center;gap:6px;">
            <span class="muted" style="font-size:12px;">Скорость:</span>
            <div class="btn-group" style="display:inline-flex;gap:4px;">
                @foreach (var spd in _speedOptions)
                {
                    <button class="btn @(_speed == spd ? "primary" : "")" style="padding:4px 8px;font-size:11px;"
                            @onclick="() => SetSpeed(spd)">@(spd)x</button>
                }
            </div>
        </div>
    </div>
</section>

<section class="glass panel" style="padding:12px;margin-top:16px;">
    <div class="canvas-frame">
        <CanvasHost @ref="_canvasHost" Style="width:100%;height:520px;" Hosted="OnCanvasHosted" />
    </div>
</section>

@code {
    private IFractalGenerator? _generator;
    private CanvasHost? _canvasHost;
    private FractalGeometry? _geometry;

    private int _order = 3;
    private int _maxOrder = 100;
    private double _lineWidth = 1.5;
    private string _formattedSegments = "343";
    private double _genMs;
    private double _drawMs;
    private bool _busy;
    private bool _hostReady;
    private string? _status;

    // Step-by-step playback state
    private int _totalSteps = 343;
    private int _currentStep = 343;
    private double _currentProgress = 1.0;
    private bool _isPlaying;
    private double _speed = 1.0;
    private readonly double[] _speedOptions = [0.5, 1.0, 2.0, 5.0, 10.0];
    private CancellationTokenSource? _playCts;

    private CancellationTokenSource? _debounceCts;

    private string _drawnSegmentsLabel
    {
        get
        {
            if (_order <= 11)
            {
                long total = _order <= 0 ? 1 : (long)Math.Pow(7, _order);
                long drawn = (long)Math.Round(total * _currentProgress);
                return drawn.ToString("N0");
            }
            else
            {
                double log10 = _order * Math.Log10(7);
                double exp = Math.Floor(log10);
                double mantissa = Math.Pow(10, log10 - exp) * _currentProgress;
                return $"{mantissa:0.00} × 10^{exp:0}";
            }
        }
    }

    protected override void OnInitialized()
    {
        _generator = Catalog.Fractals.Get("gosper") ?? Catalog.Fractals.GetAll().FirstOrDefault();
        if (_generator is not null)
        {
            _order = _generator.DefaultOrder;
            _maxOrder = _generator.MaxOrder;
        }
        UpdateSegments();
    }

    private async Task OnCanvasHosted()
    {
        _hostReady = true;
        await Viz.BindRangeFillsAsync();
        if (_geometry is not null)
            await RedrawAsync();
    }

    private void OnOrderInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var n))
            return;

        Pause();
        _order = Math.Clamp(n, 0, _maxOrder);
        UpdateSegments();
        _ = DebouncedGenerateAsync();
    }

    private void OnOrderNumberChange(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var n))
            return;

        Pause();
        _order = Math.Clamp(n, 0, _maxOrder);
        UpdateSegments();
        _ = DebouncedGenerateAsync();
    }

    private void OnWidthInput(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), out var w))
            return;
        _lineWidth = w;
        _ = RedrawAsync();
    }

    private async Task DebouncedGenerateAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var ct = _debounceCts.Token;

        try
        {
            await Task.Delay(80, ct);
            if (!ct.IsCancellationRequested)
                await GenerateAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void UpdateSegments()
    {
        _formattedSegments = GosperCurveGenerator.FormatSegmentCount(_order);
    }

    private void UpdateSteps()
    {
        if (_geometry is null || _geometry.PointCount <= 1)
        {
            _totalSteps = 1;
            _currentStep = 1;
            _currentProgress = 1.0;
            return;
        }

        int count = _geometry.PointCount - 1;
        // Для малых n делаем честный шаг по каждому сегменту, для больших — 1000 микрошагов
        _totalSteps = count <= 1000 ? Math.Max(1, count) : 1000;
        _currentStep = _totalSteps;
        _currentProgress = 1.0;
    }

    private async Task GenerateAsync()
    {
        if (_generator is null || _busy)
            return;

        Pause();
        _busy = true;
        _status = "Генерация…";
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            int order = Math.Clamp(_order, 0, _maxOrder);
            var sw = System.Diagnostics.Stopwatch.StartNew();

            _geometry = _generator.Generate(new FractalRequest(order));
            await Task.Yield();

            sw.Stop();
            _genMs = sw.Elapsed.TotalMilliseconds;
            UpdateSegments();
            UpdateSteps();

            await RedrawAsync();
            _status = $"Готово · n={order} · точек {_geometry.PointCount:N0} · gen {_genMs:0.0} мс · draw {_drawMs:0.0} мс";
        }
        catch (OperationCanceledException)
        {
            _status = "Отменено";
        }
        catch (Exception ex)
        {
            _status = $"Ошибка: {ex.Message}";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task RedrawAsync()
    {
        if (_geometry is null || _canvasHost is null || !_hostReady)
            return;

        var sw = System.Diagnostics.Stopwatch.StartNew();
        var options = new DrawOptions(
            LineColor: "#5b8cff",
            LineWidth: _lineWidth,
            Background: "rgba(0,0,0,0)",
            Pad: 28,
            Glow: "rgba(124,255,203,0.55)",
            Progress: _currentProgress);

        await _canvasHost.DrawAsync(_geometry.Xy, options);
        sw.Stop();
        _drawMs = sw.Elapsed.TotalMilliseconds;
    }

    private async Task UpdateCanvasProgressAsync()
    {
        if (_canvasHost is not null && _hostReady)
        {
            await _canvasHost.SetProgressAsync(_currentProgress);
        }
    }

    private async Task OnProgressSliderInput(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var s))
            return;

        Pause();
        _currentStep = Math.Clamp(s, 0, _totalSteps);
        _currentProgress = _totalSteps > 0 ? (double)_currentStep / _totalSteps : 1.0;
        await UpdateCanvasProgressAsync();
    }

    private async Task SeekStartAsync()
    {
        Pause();
        _currentStep = 0;
        _currentProgress = 0.0;
        await UpdateCanvasProgressAsync();
    }

    private async Task SeekEndAsync()
    {
        Pause();
        _currentStep = _totalSteps;
        _currentProgress = 1.0;
        await UpdateCanvasProgressAsync();
    }

    private async Task StepBackAsync()
    {
        Pause();
        _currentStep = Math.Max(0, _currentStep - 1);
        _currentProgress = _totalSteps > 0 ? (double)_currentStep / _totalSteps : 0.0;
        await UpdateCanvasProgressAsync();
    }

    private async Task StepForwardAsync()
    {
        Pause();
        _currentStep = Math.Min(_totalSteps, _currentStep + 1);
        _currentProgress = _totalSteps > 0 ? (double)_currentStep / _totalSteps : 1.0;
        await UpdateCanvasProgressAsync();
    }

    private void SetSpeed(double speed)
    {
        _speed = speed;
    }

    private async Task PlayAsync()
    {
        if (_geometry is null)
            return;

        if (_currentStep >= _totalSteps)
        {
            _currentStep = 0;
            _currentProgress = 0.0;
            await UpdateCanvasProgressAsync();
        }

        _isPlaying = true;
        _playCts?.Cancel();
        _playCts?.Dispose();
        _playCts = new CancellationTokenSource();
        var ct = _playCts.Token;

        _ = RunPlaybackLoopAsync(ct);
    }

    private void Pause()
    {
        _isPlaying = false;
        _playCts?.Cancel();
        StateHasChanged();
    }

    private async Task RunPlaybackLoopAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested && _currentStep < _totalSteps)
            {
                int increment = _speed >= 5.0 ? (int)(_speed / 2.0) : 1;
                _currentStep = Math.Min(_totalSteps, _currentStep + increment);
                _currentProgress = _totalSteps > 0 ? (double)_currentStep / _totalSteps : 1.0;

                await UpdateCanvasProgressAsync();
                StateHasChanged();

                int delay = (int)Math.Max(8, 32.0 / _speed);
                await Task.Delay(delay, ct);
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (_currentStep >= _totalSteps)
            {
                _currentStep = _totalSteps;
                _currentProgress = 1.0;
                _isPlaying = false;
                await UpdateCanvasProgressAsync();
                StateHasChanged();
            }
        }
    }

    private async Task ResetViewAsync()
    {
        if (_canvasHost is not null)
            await _canvasHost.ResetViewAsync();
    }

    private async Task ExportAsync()
    {
        if (_canvasHost is null)
            return;
        await _canvasHost.ExportPngAsync($"gosper-n{_order}.png");
    }

    private async Task ResetAsync()
    {
        Pause();
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = null;
        _geometry = null;
        _status = null;
        _order = _generator?.DefaultOrder ?? 3;
        _genMs = 0;
        _drawMs = 0;
        UpdateSegments();
        UpdateSteps();
        if (_canvasHost is not null && _hostReady)
        {
            await _canvasHost.DrawAsync(
                ReadOnlyMemory<float>.Empty,
                new DrawOptions("#5b8cff", _lineWidth, "rgba(0,0,0,0)", 28, null, 1));
            await _canvasHost.ResetViewAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        Pause();
        _playCts?.Dispose();
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        if (_canvasHost is not null)
            await _canvasHost.DisposeAsync();
    }
}
