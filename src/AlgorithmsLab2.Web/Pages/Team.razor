@page "/team"
@implements IAsyncDisposable
@inject CatalogState Catalog
@inject MiniChartService Chart
@inject TeamVizService Viz

<PageTitle>Командные алгоритмы</PageTitle>

<header class="page-header">
    <div>
        <h1>Командные алгоритмы</h1>
        <p>
            Рекурсивные алгоритмы: разбиение числа на слагаемые, дерево Штерна–Броко,
            умножение Карацубы — с визуализацией, демо и замерами.
        </p>
    </div>
</header>

<div class="card-grid">
    @foreach (var algo in _algos)
    {
        <div class="glass card @(algo.Id == _selectedId ? "selected-card" : "")" @onclick="() => Select(algo.Id)">
            <div class="row" style="justify-content:space-between;align-items:center;">
                <h3>@algo.Name</h3>
                <span class="badge accent">@algo.Slot</span>
            </div>
            <p>@algo.Description</p>
            <div class="stat-row">
                <span class="stat-chip">@algo.Complexity.Display</span>
            </div>
        </div>
    }
</div>

@if (_selected is not null)
{
    <section class="glass panel" style="margin-top:16px;">
        <h2>@_selected.Name</h2>
        <p>@_selected.Description</p>
        <p class="muted">@_selected.PracticalApplication</p>
        <div class="stat-row">
            <span class="stat-chip">Best: @_selected.Complexity.Best</span>
            <span class="stat-chip">Avg: @_selected.Complexity.Average</span>
            <span class="stat-chip">Worst: @_selected.Complexity.Worst</span>
        </div>
    </section>

    <section class="glass panel">
        <h2>Визуализация</h2>
        <div class="viz-frame">
            <canvas @ref="_vizCanvas" style="width:100%;height:100%;"></canvas>
        </div>
        <p class="muted" style="margin-top:8px;">@_vizCaption</p>
    </section>

    @if (_runner is not null)
    {
        <div class="row" style="align-items:stretch;">
            <section class="glass panel" style="flex:1 1 320px;">
                <h2>Демо</h2>
                <div class="row">
                    <div class="field">
                        <label>n</label>
                        <input type="number" min="0" max="40" value="@_demoN" @oninput="OnDemoN" />
                    </div>
                    <div class="field">
                        <label>Метрика</label>
                        <div class="stat-chip">@_metricLabel</div>
                    </div>
                </div>
                <div class="btn-row" style="margin-top:10px;">
                    <button class="btn primary" disabled="@_demoBusy" @onclick="RunDemoAsync">Демо</button>
                    <button class="btn" @onclick="Cancel">Стоп</button>
                </div>
                <div class="trace" style="margin-top:12px;max-height:280px;overflow:auto;">
                    @foreach (var step in _trace.Take(80))
                    {
                        <div class="trace-row">
                            <span class="muted">#@step.Index</span>
                            <strong>@step.Label</strong>
                            <span>@step.Detail</span>
                        </div>
                    }
                    @if (_trace.Count > 80)
                    {
                        <div class="muted">… ещё @(_trace.Count - 80)</div>
                    }
                </div>
            </section>

            <section class="glass panel" style="flex:1 1 320px;">
                <h2>Замеры</h2>
                <div class="row">
                    <div class="field">
                        <label>N min</label>
                        <input type="number" value="@_nMin" @oninput="e => _nMin = ParseInt(e, 1)" />
                    </div>
                    <div class="field">
                        <label>N max</label>
                        <input type="number" value="@_nMax" @oninput="e => _nMax = ParseInt(e, 12)" />
                    </div>
                    <div class="field">
                        <label>Итераций</label>
                        <input type="number" min="1" max="20" value="@_iters" @oninput="e => _iters = ParseInt(e, 3)" />
                    </div>
                </div>
                <div class="btn-row" style="margin-top:10px;">
                    <button class="btn primary" disabled="@_benchBusy" @onclick="RunBenchAsync">Замерить</button>
                    <button class="btn" @onclick="Cancel">Стоп</button>
                </div>
                <div style="margin-top:12px;height:240px;">
                    <canvas @ref="_chartCanvas" style="width:100%;height:240px;"></canvas>
                </div>
                <table class="data" style="margin-top:10px;">
                    <thead>
                        <tr><th>n</th><th>мс</th><th>шаги</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _points.TakeLast(12))
                        {
                            <tr>
                                <td>@p.N</td>
                                <td>@p.ElapsedMs.ToString("0.###")</td>
                                <td>@p.Steps</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        </div>
    }

    @if (_status is not null)
    {
        <p class="muted" style="margin:12px 0;">@_status</p>
    }
}

@code {
    private List<ITeamAlgorithm> _algos = new();
    private ITeamAlgorithm? _selected;
    private IRecursiveAlgorithm? _runner;
    private string? _selectedId;

    private int _demoN = 5;
    private int _nMin = 1;
    private int _nMax = 12;
    private int _iters = 3;
    private string _metricLabel = "—";

    private bool _demoBusy;
    private bool _benchBusy;
    private readonly List<TraceStep> _trace = new();
    private readonly List<BenchmarkPoint> _points = new();
    private string? _status;
    private string _vizCaption = "";
    private ElementReference _chartCanvas;
    private ElementReference _vizCanvas;
    private bool _chartReady;
    private bool _vizReady;

    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _algos = Catalog.Team.GetAll()
            .OrderBy(a => a.Slot == "main" ? 0 : a.Slot == "slot-b" ? 1 : 2)
            .ToList();
        var first = _algos.FirstOrDefault();
        if (first is not null)
            await Select(first.Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Chart.CreateAsync(_chartCanvas);
            await Viz.CreateAsync(_vizCanvas);
            _chartReady = true;
            _vizReady = true;
            await RedrawVizAsync();
        }
    }

    private async Task Select(string id)
    {
        _selectedId = id;
        _selected = _algos.FirstOrDefault(a => a.Id == id);
        _runner = _selected is null ? null : Catalog.Team.GetRunner(id);
        _trace.Clear();
        _points.Clear();
        _status = null;
        _demoN = id switch
        {
            "team-integer-partitions" => 5,
            "team-stern-brocot" => 4,
            "team-karatsuba" => 8,
            _ => 5
        };
        _metricLabel = id switch
        {
            "team-integer-partitions" => $"p({_demoN})",
            "team-stern-brocot" => "вершины / шаги",
            "team-karatsuba" => "вызовы Multiply",
            _ => "—"
        };

        if (_vizReady)
            await RedrawVizAsync();
        StateHasChanged();
    }

    private async Task RedrawVizAsync()
    {
        if (!_vizReady || _selected is null)
            return;

        if (_selected.Id == "team-stern-brocot" && _selected is SternBrocotAlgorithm sb)
        {
            int depth = Math.Clamp(_demoN, 1, 6);
            var tree = sb.GenerateTree(depth);
            int count = tree.Count;
            var nodes = new (double X, double Y)[count];
            var edges = new List<(int A, int B)>();
            var labels = new List<string>(count);

            // компактный layout полного бинарного дерева (inorder → x)
            void Place(int left, int right, int level, int maxLevel)
            {
                if (left > right)
                    return;
                int mid = (left + right) / 2;
                double x = (mid + 0.5) / count;
                double y = 0.12 + 0.72 * (level / Math.Max(1.0, maxLevel - 1));
                nodes[mid] = (x, y);
                if (left <= mid - 1)
                {
                    edges.Add((mid, (left + mid - 1) / 2));
                    Place(left, mid - 1, level + 1, maxLevel);
                }
                if (mid + 1 <= right)
                {
                    edges.Add((mid, (mid + 1 + right) / 2));
                    Place(mid + 1, right, level + 1, maxLevel);
                }
            }

            Place(0, count - 1, 0, depth);
            for (int i = 0; i < count; i++)
                labels.Add(tree[i].ToString());

            await Viz.DrawTreeAsync(_vizCanvas, nodes.ToList(), edges, labels);
            _vizCaption = $"Дерево Штерна–Броко, глубина {depth}: {tree.Count} вершин.";
        }
        else if (_selected.Id == "team-karatsuba" && _selected is KaratsubaAlgorithm ka)
        {
            int n = Math.Clamp(_demoN, 4, 20);
            string xs = new string('1', n);
            string ys = new string('2', n);
            var log = ka.TraceMultiply(
                System.Numerics.BigInteger.Parse(xs),
                System.Numerics.BigInteger.Parse(ys));
            var depths = new List<float>();
            foreach (var line in log)
            {
                int indent = line.Length - line.TrimStart().Length;
                depths.Add((indent / 2) + 1);
            }

            await Viz.DrawBarsAsync(_vizCanvas, depths, "Глубина рекурсии Карацубы (шаги разбора)");
            _vizCaption = $"Трасса умножения {n}-значных чисел: {log.Count} шагов, 3 подвызова на уровень.";
        }
        else if (_selected.Id == "team-integer-partitions" && _selected is IntegerPartitionsAlgorithm ip)
        {
            int n = Math.Clamp(_demoN, 1, 12);
            var parts = ip.EnumeratePartitions(n, CancellationToken.None).Take(40).ToList();
            var sizes = parts.Select(p => (float)p.Count).ToList();
            await Viz.DrawBarsAsync(_vizCanvas, sizes, $"Разбиения n={n}: длина каждого (кол-во слагаемых)");
            _vizCaption = $"Первые разбиения числа {n} (показано {sizes.Count}): столбцы — число слагаемых.";
        }
        else
        {
            await Viz.DrawBarsAsync(_vizCanvas, Array.Empty<float>(), "нет данных");
            _vizCaption = "";
        }
    }

    private void OnDemoN(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n))
        {
            _demoN = n;
            if (_selected?.Id == "team-integer-partitions")
                _metricLabel = $"p({Math.Clamp(n, 0, 30)})";
            _ = RedrawVizAsync();
        }
    }

    private static int ParseInt(ChangeEventArgs e, int fallback) =>
        int.TryParse(e.Value?.ToString(), out var v) ? v : fallback;

    private async Task RunDemoAsync()
    {
        if (_runner is null)
            return;

        Cancel();
        _cts = new CancellationTokenSource();
        _demoBusy = true;
        _trace.Clear();
        _status = "Демо…";
        StateHasChanged();

        try
        {
            await foreach (var step in _runner.DemoAsync(new DemoRequest(_demoN), _cts.Token))
            {
                _trace.Add(step);
                if (_trace.Count % 16 == 0)
                {
                    StateHasChanged();
                    await Task.Yield();
                }
            }

            if (_selected?.Id == "team-integer-partitions" && _selected is IntegerPartitionsAlgorithm ip)
                _metricLabel = $"p({_demoN}) = {ip.CountPartitions(Math.Clamp(_demoN, 0, 30))}";

            _status = $"Демо готово · шагов {_trace.Count}";
        }
        catch (OperationCanceledException)
        {
            _status = "Демо отменено";
        }
        catch (Exception ex)
        {
            _status = $"Демо: {ex.Message}";
        }
        finally
        {
            _demoBusy = false;
            StateHasChanged();
        }
    }

    private async Task RunBenchAsync()
    {
        if (_runner is null)
            return;

        Cancel();
        _cts = new CancellationTokenSource();
        _benchBusy = true;
        _points.Clear();
        _status = "Замеры…";
        StateHasChanged();

        var request = new BenchmarkRequest(
            Math.Max(0, _nMin),
            Math.Max(_nMin, _nMax),
            1,
            Math.Clamp(_iters, 1, 20));

        try
        {
            await foreach (var p in _runner.RunAsync(request, _cts.Token))
            {
                _points.Add(p);
                StateHasChanged();
                await Task.Yield();
            }

            if (_chartReady)
            {
                var pts = _points.Select(p => ((double)p.N, p.ElapsedMs)).ToList();
                await Chart.DrawAsync(_chartCanvas, pts, new ChartOptions(
                    LineColor: "#5b8cff",
                    PointColor: "#7cffcb",
                    Title: "Среднее время от n (мс)",
                    XLabel: "n",
                    YLabel: "ms",
                    YLogScale: false));
            }

            _status = $"Замеры готовы · точек {_points.Count}";
        }
        catch (OperationCanceledException)
        {
            _status = "Замеры отменены";
        }
        catch (Exception ex)
        {
            _status = $"Замеры: {ex.Message}";
        }
        finally
        {
            _benchBusy = false;
            StateHasChanged();
        }
    }

    private void Cancel()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
    }

    public async ValueTask DisposeAsync()
    {
        Cancel();
        await Viz.DisposeAsync();
    }
}
